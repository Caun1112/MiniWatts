#!/bin/sh
set -eu
PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
case "${1:-}" in
    remove|upgrade|deconfigure)
        # Stop first so automatic policy cannot reapply after the reset command.
        ctl=/bin/launchctl
        for candidate in /var/jb/bin/launchctl /var/jb/usr/bin/launchctl; do
            if [ -x "$candidate" ]; then ctl=$candidate; break; fi
        done
        # Remove the independent watchdog before stopping/resetting control.
        "$ctl" bootout system /var/jb/Library/LaunchDaemons/org.zhaohe.MiniWatts.charge.watchdog.plist 2>/dev/null || true
        "$ctl" bootout system /var/jb/Library/LaunchDaemons/org.zhaohe.MiniWatts.charge.plist 2>/dev/null || true
        helper=/var/jb/Applications/MiniWatts.app/MiniWattsChargeDaemon
        if [ -x "$helper" ]; then
            "$helper" stop
            "$helper" reset
        fi
        if [ "${1:-}" = remove ]; then
            if [ -x /var/jb/usr/bin/uicache ]; then
                /var/jb/usr/bin/uicache -u /var/jb/Applications/MiniWatts.app
            elif command -v uicache >/dev/null 2>&1; then
                uicache -u /var/jb/Applications/MiniWatts.app
            fi
        fi
        ;;
esac
