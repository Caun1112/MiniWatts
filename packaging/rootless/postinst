#!/bin/sh
set -eu
PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
case "${1:-}" in
 configure|abort-upgrade|abort-remove|abort-deconfigure)
    mkdir -p /var/jb/var/log
    log=/var/jb/var/log/miniwatts-charge-install.log
    : > "$log"
    chmod 0644 "$log"
    touch /var/jb/var/log/miniwatts-charge-startup.log
    chmod 0644 /var/jb/var/log/miniwatts-charge-startup.log
    ctl=/bin/launchctl
    for candidate in /var/jb/bin/launchctl /var/jb/usr/bin/launchctl; do
        if [ -x "$candidate" ]; then ctl=$candidate; break; fi
    done
    plist=/var/jb/Library/LaunchDaemons/org.zhaohe.MiniWatts.charge.plist
    watchdog=/var/jb/Library/LaunchDaemons/org.zhaohe.MiniWatts.charge.watchdog.plist
    helper=/var/jb/Applications/MiniWatts.app/MiniWattsChargeDaemon
    {
        echo "MiniWatts installation: $(date -u), launchctl=$ctl"
        "$ctl" bootout system "$watchdog" || true
        "$ctl" bootout system "$plist" || true
        "$helper" stop || true
        "$helper" ensure-launchd || true
        "$ctl" print system/org.zhaohe.MiniWatts.charge || true
        "$ctl" enable system/org.zhaohe.MiniWatts.charge.watchdog || true
        "$ctl" bootstrap system "$watchdog" || true
        "$ctl" kickstart system/org.zhaohe.MiniWatts.charge.watchdog || true
        "$ctl" print system/org.zhaohe.MiniWatts.charge.watchdog || true
    } >> "$log" 2>&1
    cat "$log"
    if [ -x /var/jb/usr/bin/uicache ]; then
        /var/jb/usr/bin/uicache -p /var/jb/Applications/MiniWatts.app
    elif command -v uicache >/dev/null 2>&1; then
        uicache -p /var/jb/Applications/MiniWatts.app
    fi
    ;;
esac
